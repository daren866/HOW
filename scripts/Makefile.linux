# Makefile.linux - HOW Linux x64 构建（gcc + X11/Xft）
# 用法: make -f scripts/Makefile.linux            # 产物 HOW（或 HOW=xxx 指定）
#       make -f scripts/Makefile.linux HEADLESS=1 # 同上（保留，语义提示）
# 依赖: libx11-dev libxft-dev libfontconfig1-dev（CI: apt 安装）

CC      ?= gcc
HOW     ?= HOW
ROOT     = $(dir $(abspath $(lastword $(MAKEFILE_LIST))))..

# Linux 侧平台层 = host_linux.c + plat_linux.c（替代 main/compat/store/selftest/arkrt）
SRC = src/host_linux.c src/plat_linux.c src/ui_parse.c src/ui_render.c \
      src/abc.c src/json.c \
      third_party/miniz/miniz.c third_party/miniz/miniz_tdef.c \
      third_party/miniz/miniz_tinfl.c third_party/miniz/miniz_zip.c
INC = -Isrc -Ithird_party/miniz
CFLAGS  = -O2 -Wall -std=gnu11
PKG     = $(shell pkg-config --silence-errors --cflags x11 xft fontconfig 2>/dev/null || echo -I/usr/include/freetype2)
LIBS    = $(shell pkg-config --libs x11 xft fontconfig 2>/dev/null || echo -lX11 -lXft -lfontconfig -lpthread)

$(HOW): $(SRC) src/how.h src/howcore.h src/plat_linux.h
	$(CC) $(SRC) $(INC) $(CFLAGS) $(PKG) $(LIBS) -o $@

clean:
	rm -f $(HOW)

.PHONY: clean
